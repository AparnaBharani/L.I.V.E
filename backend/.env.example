# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored; this example file is committed and must only contain placeholders.
#
# If your password contains special characters, URL-encode them, e.g. "@" -> "%40".
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/live_db

# Used only by pytest. Must be a DIFFERENT database whose name ends in "_test":
# every test run DROPS and recreates it. pytest refuses to run if this is missing.
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/live_db_test
